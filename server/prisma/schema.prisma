generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  currency     String   @default("EUR")
  timezone     String   @default("Europe/Amsterdam")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}